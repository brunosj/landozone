PUBLIC_CONTACT_EMAIL=
PUBLIC_GITHUB_PAGE=
PUBLIC_LINKEDIN_PROFILE=
PUBLIC_SITE_URL=
PUBLIC_TELEGRAM_USERNAME=
RESEND_API_KEY=

# Cloudflare Turnstile
# Public site key is baked in at `vite build` (same as other PUBLIC_* vars).
# The secret must also be present at build, and in the Node process at runtime
# if you use $env/dynamic — adapter-node does not load this file automatically.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
